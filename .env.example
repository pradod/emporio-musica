# Qualquer endpoint compatível com a API da OpenAI (Chat Completions + tools).
#
# Ollama local (padrão):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:14b
#
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
#
# Groq / OpenRouter / LM Studio / vLLM: basta trocar base_url, chave e modelo.

LLM_TEMPERATURE=0.2

# Data "de hoje" usada pelo agente (AAAA-MM-DD ou AAAA-MM-DDTHH:MM).
# Vazio = data/hora real. Os dados da loja terminam em 22/03/2026, por isso os
# exemplos do repositório usam 2026-03-25T10:30 (ver README, seção Suposições).
EMPORIO_DATA_REFERENCIA=
